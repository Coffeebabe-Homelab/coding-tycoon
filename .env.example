# PostgreSQL (used by Docker Compose for prod-like local runs)
DB_USER=codingtycoon
DB_PASSWORD=codingtycoon

# Auth0
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.codingtycoon.dev

# Frontend (.env.local — copy to frontend/.env.local, never commit)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.codingtycoon.dev
VITE_API_BASE_URL=http://localhost:8080
