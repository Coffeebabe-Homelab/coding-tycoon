{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select the bundled Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Select the bundled Loki data source",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Select the bundled Tempo data source",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "id": null,
  "uid": "coding-tycoon-backend",
  "title": "Coding Tycoon \u2014 Backend overview",
  "description": "Starter dashboard for Quarkus OpenTelemetry in the bundled LGTM stack.",
  "tags": [
    "coding-tycoon",
    "quarkus",
    "opentelemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(target_info, service_name)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(target_info, service_name)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "coding-tycoon-backend",
          "value": "coding-tycoon-backend"
        },
        "options": []
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(target_info{service_name=~\"${service:regex}\"}, deployment_environment)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(target_info{service_name=~\"${service:regex}\"}, deployment_environment)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Start here",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Backend OpenTelemetry overview. Select a service and environment; **All** includes staging still labelled `homelab`. Generate traffic and allow at least 60 seconds for export. Rates need two samples. Empty panels mean missing data, not a healthy service. HTTP panels include health requests. Logs are ordinary application logs, not access logs. Expand a trace to inspect it; if search is empty, copy a log trace_id into Tempo Explore."
      }
    },
    {
      "id": 2,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((rate(http_server_request_duration_seconds_count{}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"}))",
          "legendFormat": "Backend",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP 5xx / second",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Zero only when request metrics exist but no 5xx series exists. No data does not mean zero errors.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"})) or (sum((rate(http_server_request_duration_seconds_count{}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"})) * 0)",
          "legendFormat": "Backend",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Histogram estimate across all routes and instances. Idle traffic may produce no value.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) ((rate(http_server_request_duration_seconds_bucket{}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"})))",
          "legendFormat": "Backend",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "title": "Request rate by route",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) ((rate(http_server_request_duration_seconds_count{}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"}))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Request rate by status",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) ((rate(http_server_request_duration_seconds_count{}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"}))",
          "legendFormat": "{{http_response_status_code}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "JVM memory used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Memory used, summed across selected instances; not a heap utilization percentage.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jvm_memory_type) ((jvm_memory_used_bytes) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"}))",
          "legendFormat": "{{jvm_memory_type}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "JVM GC time / second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Seconds spent in garbage collection per second, summed across selected instances.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum((rate(jvm_gc_duration_seconds_sum{}[$__rate_interval])) * on (job, instance) group_left max by (job, instance) (target_info{service_name=~\"${service:regex}\", deployment_environment=~\"${environment:regex}\"}))",
          "legendFormat": "Backend",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Recent backend logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"${service:regex}\"} | deployment_environment=~\"${environment:regex}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 10,
      "title": "Recent backend traces",
      "description": "Search indexing can lag. Use a trace_id from logs in Tempo Explore if this table is empty.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && resource.deployment.environment =~ \"${environment:regex}\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ]
}
